#!/usr/bin/env ruby
# frozen_string_literal: true

require_relative "../lib/ecapi"

def usage!
  abort <<~USAGE
    Usage:
      bin/ecapi-credentials create ADVERTISER_ID DATA_SET_ID [DATA_SET_ID...]
      bin/ecapi-credentials rotate CREDENTIAL_ID
      bin/ecapi-credentials revoke CREDENTIAL_ID
  USAGE
end

begin
  command = ARGV.shift
  manager = Ecapi::CredentialManager.new

  case command
  when "create"
    advertiser_id = ARGV.shift
    usage! if advertiser_id.nil? || ARGV.empty?
    result = manager.create(advertiser_id, ARGV)
    puts "credential_id=#{result.fetch(:id)}"
    puts "data_set_ids=#{result.fetch(:data_set_ids).join(",")}"
    puts "token=#{result.fetch(:token)}"
    warn "Store this token securely now; it cannot be retrieved later."
  when "rotate"
    usage! unless ARGV.length == 1
    result = manager.rotate(Integer(ARGV.first, 10))
    puts "credential_id=#{result.fetch(:id)}"
    puts "data_set_ids=#{result.fetch(:data_set_ids).join(",")}"
    puts "token=#{result.fetch(:token)}"
    warn "The old credential was revoked. Store this replacement token securely now."
  when "revoke"
    usage! unless ARGV.length == 1
    manager.revoke(Integer(ARGV.first, 10))
    puts "credential_id=#{ARGV.first}"
    puts "status=revoked"
  else
    usage!
  end
rescue ArgumentError, Ecapi::UnknownCredentialError, Ecapi::DatabaseConfigurationError => error
  warn "ecapi-credentials: #{error.message}"
  exit 1
end
